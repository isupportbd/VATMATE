APP_NAME=VATMATE
APP_ENV=production
APP_KEY=base64:NTfYCkEQ52s64mjBD3QE7kdpWCAFritWGqNwCYduNbg=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com
TRUSTED_PROXIES=*

# Database Setup (PostgreSQL in Coolify)
DB_CONNECTION=pgsql
DB_HOST=your-postgres-service-name
DB_PORT=5432
DB_DATABASE=vatmate
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Cache, Queue & Session (Redis in Coolify)
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
CACHE_PREFIX=vatmate_cache
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_PREFIX=vatmate_
REDIS_CLIENT=phpredis
REDIS_HOST=your-redis-service-name
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# App Contact info for email notifications
CONTACT_CENTER_PHONE="+8801XXXXXXXXX"

# Super Admin / Admin Seeder defaults (Optional)
SUPERADMIN_EMAIL=admin@your-domain.com
SUPERADMIN_PASSWORD=your_secure_password
SUPERADMIN_MOBILE=+8801XXXXXXXXX

# Horizon allowed emails (Superadmin role_id=1 is allowed automatically)
HORIZON_ALLOWED_EMAILS=admin@your-domain.com

VITE_APP_NAME="${APP_NAME}"

# Browsershot for PDF generation
BROWSERSHOT_CHROME_PATH="/usr/bin/chromium"

# Laravel Reverb (WebSocket)
REVERB_APP_ID=845383
REVERB_APP_KEY=erzaeliisc5en6hz1j1y
REVERB_APP_SECRET=uqg1ynvi9bavawyjjcf6

# External facing Reverb URL
REVERB_HOST=reverb.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

# Internal Reverb server setup
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

# Reverb Redis options
REVERB_USE_REDIS=true
REVERB_PUBSUB_REDIS_CONNECTION=default
REVERB_MAX_CONNECTIONS=6000
REVERB_MAX_REQUEST_SIZE=2048
REVERB_HEARTBEAT_INTERVAL=20
REVERB_HEARTBEAT_TIMEOUT=60

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
